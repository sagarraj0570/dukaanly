# ─────────────────────────────────────────────
#  DUKAANLY — Environment Variables Template
#  Copy to .env and fill in real values.
#  NEVER commit the actual .env file.
# ─────────────────────────────────────────────

# ── Application ───────────────────────────────
APP_ENV=development        # development | production
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173

# ── PostgreSQL ────────────────────────────────
POSTGRES_PORT=5433   # Host-side port; container always runs on 5432 internally
POSTGRES_DB=dukaanly
POSTGRES_USER=dukaanly_user
POSTGRES_PASSWORD=changeme

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0


# ── JWT ───────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Payment (Intentionally Mocked) ────────────
# No real gateway credentials needed for MVP.
# This section is a placeholder for future integration.
PAYMENT_GATEWAY=mock
